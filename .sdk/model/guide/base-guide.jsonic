# Guide

guide: {
  metrics: count: entity: 1
  metrics: count: path: 1
  metrics: count: method: 1

  entity: playlist: {
    path: "/stations/{station}/playlist": {
      rename: param: "station": *"station_id"
      op: list: method: *GET
      op: list: transform: res: *("`body.playlist`")|top
    }
  }

}